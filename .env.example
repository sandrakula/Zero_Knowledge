# ZeroKnowledge environment template.
# Copy to `.env` next to docker-compose.yml and fill in real values.
# Docker Compose reads `.env` automatically; the values are passed to the API
# container through the `environment` block. Secrets NEVER go in the repo.

# ── Core (already referenced by docker-compose.yml) ──────────────────────────
# JWT signing secret (REQUIRED; >= 32 chars). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
LEARNHOUSE_AUTH_JWT_SECRET_KEY=change-me-to-a-long-random-secret

# Bootstrap admin (used only on first boot / empty DB).
LEARNHOUSE_INITIAL_ADMIN_EMAIL=admin@school.dev
LEARNHOUSE_INITIAL_ADMIN_PASSWORD=change-me-strong-password

# ── Email delivery + verification ────────────────────────────────────────────
# Provider: "resend" (recommended) or "smtp".
LEARNHOUSE_EMAIL_PROVIDER=resend

# Resend (https://resend.com):
#   1. Create an account and add your sending domain (Domains → Add domain).
#   2. Add the DNS records Resend shows (SPF + DKIM, and the optional MX) and
#      wait for the domain to be marked "Verified".
#   3. Create an API key (API Keys → Create API key) and paste it below.
#   4. system_email_address MUST be on a domain you verified in Resend,
#      e.g. no-reply@yourdomain.com — otherwise the send is rejected.
LEARNHOUSE_RESEND_API_KEY=
LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=no-reply@yourdomain.com
LEARNHOUSE_SYSTEM_EMAIL_SENDER_NAME=ZeroKnowledge

# SMTP fallback (ignored while LEARNHOUSE_EMAIL_PROVIDER=resend).
# For Gmail use an App Password (https://myaccount.google.com/apppasswords),
# never your real account password. Port 465 uses implicit TLS; 587 uses STARTTLS.
LEARNHOUSE_SMTP_HOST=
LEARNHOUSE_SMTP_PORT=587
LEARNHOUSE_SMTP_USERNAME=
LEARNHOUSE_SMTP_PASSWORD=
LEARNHOUSE_SMTP_USE_TLS=true

# Public base URL used inside emailed verification/login links for org-less
# (apex) signups, e.g. https://yourdomain.com. Leave empty to derive it from the
# request / LEARNHOUSE_FRONTEND_DOMAIN.
LEARNHOUSE_PLATFORM_URL=

# Require email confirmation before a new email+password account can log in.
# Default true (production-safe). The false value is a LOCAL-DEV convenience
# only: it is ignored unless LEARNHOUSE_DEVELOPMENT_MODE is also true.
LEARNHOUSE_REQUIRE_EMAIL_VERIFICATION=true

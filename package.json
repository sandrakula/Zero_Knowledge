{
  "name": "zeroknowledge",
  "version": "0.1.0",
  "private": true,
  "description": "Learning Intelligence Platform — adaptive learning twin, knowledge graph, evidence engine, and provider-abstracted AI tutoring.",
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "4.6.0",
    "@prisma/client": "6.2.1",
    "clsx": "2.1.1",
    "dotenv": "16.4.7",
    "framer-motion": "11.15.0",
    "lucide-react": "0.469.0",
    "mammoth": "1.8.0",
    "next": "15.5.27",
    "pdf-parse": "1.1.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-markdown": "9.0.1",
    "remark-gfm": "4.0.0",
    "tailwind-merge": "2.6.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/react": "19.0.4",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",

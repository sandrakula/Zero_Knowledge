# Скопируй в .env (этот файл в git, .env — нет) и заполни значения.
#   Copy-Item .env.example .env
#
# Все секреты ниже — заглушки. Сгенерируй свои:
#   -join ((48..57)+(97..102) | Get-Random -Count 48 | % {[char]$_})

# Имя этой машины в tailnet: без схемы, без порта, без точки на конце.
# Узнать: tailscale status --json | ConvertFrom-Json | % { $_.Self.DNSName }
TAILNET_HOST=zerok-pc.tailnet-xxxx.ts.net

# Loopback-порт, куда смотрит `tailscale serve`. Менять не обязательно.
HTTP_PORT=8080

# --- секреты: обязательно замени ---
# API отказывается стартовать, если JWT_SECRET_KEY короче 32 символов,
# поэтому заглушки ниже уже нужной длины — их всё равно надо заменить.
POSTGRES_PASSWORD=change-me-postgres-password-0000000000
JWT_SECRET_KEY=change-me-jwt-secret-key-0000000000000000
NEXTAUTH_SECRET=change-me-nextauth-secret-0000000000000
COLLAB_INTERNAL_KEY=change-me-collab-internal-key-0000000000

# --- первый администратор ---
# Создаётся один раз, при первом старте на пустой базе. Дальше эти
# переменные ни на что не влияют (пароль меняется в UI).
#
# Почта должна выглядеть как настоящая: домены вроде `.test`, `.example`,
# `.invalid`, `.local` валидатор отвергает, и установка падает уже после
# создания организации — тогда админа не будет вовсе.
ADMIN_EMAIL=admin@school.dev
ADMIN_PASSWORD=change-me-admin-password
ORG_NAME=ZeroKnowledge Academy
ORG_SLUG=default

# --- опционально: почта (без неё письма о сбросе пароля не уходят) ---
# LEARNHOUSE_EMAIL_PROVIDER=resend
# LEARNHOUSE_RESEND_API_KEY=re_...
# LEARNHOUSE_SYSTEM_EMAIL_ADDRESS=noreply@example.com
